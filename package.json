{
  "name": "material-control-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Material Control — purchases & inventory system for RORO Transport",
  "author": "RORO Transport",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:parse": "tsx scripts/parse-check.ts",
    "demo": "node scripts/record-demo.mjs",
    "app": "npm run build && electron .",
    "app:dev": "electron .",
    "app:installer": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "@tanstack/react-query": "^5.59.0",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "ph.roro.materialcontrol",
    "productName": "Material Control",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
